# 키움 REST API 인증 정보
# https://openapi.kiwoom.com 에서 발급받은 키를 입력하세요.

KIWOOM_APP_KEY="your_app_key"
KIWOOM_APP_SECRET="your_app_secret"
KIWOOM_ACCOUNT_NO="your_account_number"

# true = 모의투자(mockapi.kiwoom.com), false = 실전투자(api.kiwoom.com).
# 모의/실전 키는 서로 다르므로 키 종류와 맞춘다. 비워 두면 KiwoomAPI.from_env() 는
# 경고를 남기고 실전투자 서버에 연결한다(생성자·MCP 서버와 같은 기본값).
KIWOOM_IS_MOCK="true"
